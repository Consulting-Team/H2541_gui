{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "report_gen",
  "mainBinaryName": "report_gen",
  "version": "1.0.0",
  "identifier": "com.VG.H2541-gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Report Generator",
        "width": 800,
        "height": 600,
        "maximizable": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resource/" : "resource/",
      "resource/env/.env_H2542": ".env"
    },
    "externalBin": [
      "binaries/report_gen/cli",
      "binaries/report_gen/average"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
