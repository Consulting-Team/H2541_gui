{
  "$schema": "https://schema.tauri.app/tauri.conf.json",
  "productName": "H2542_ReportGen",
  "mainBinaryName": "H2542_ReportGen",
  "version": "1.2.4",
  "identifier": "com.VG.ReportGen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Report Generator",
        "width": 800,
        "height": 600,
        "maximizable": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resource/env/.env_H2542": "./.env",
      "resource/" : "resource/"
    },
    "externalBin": [
      "binaries/report_gen/cli",
      "binaries/report_gen/average"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
